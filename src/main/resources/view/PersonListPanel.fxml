<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="contacts-panel" spacing="12" minWidth="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <HBox alignment="CENTER_LEFT" spacing="8">
    <Label text="Contacts" styleClass="panel-title" />
    <Label fx:id="contactCount" styleClass="count-badge" />
  </HBox>
  <ListView fx:id="personListView" styleClass="contacts-list" minWidth="0" VBox.vgrow="ALWAYS" />
</VBox>
