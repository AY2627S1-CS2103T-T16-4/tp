@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":ModelManager" as ModelManager MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
end box

[-> ModelManager : undo()
activate ModelManager

alt undoHistory is empty
    ModelManager --> ModelManager : return false
else saved state exists
    ModelManager -> AddressBook : resetData(undoHistory.pop())
    activate AddressBook
    AddressBook --> ModelManager
    deactivate AddressBook

    ModelManager -> ModelManager : updateFilteredPersonList(currentPredicate)
    ModelManager --> ModelManager : return true
end

[<-- ModelManager
deactivate ModelManager

@enduml